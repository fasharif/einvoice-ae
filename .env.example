# Example configuration. Nothing here is secret; copy the values you need into your shell
# environment (the scripts read process.env and do not load .env files).

# Mock Accredited Service Provider (npm run mock-asp, npm run example:submit)
MOCK_ASP_PORT=58800
MOCK_ASP_API_KEY=local-demo-key
MOCK_ASP_CALLBACK_SECRET=local-demo-secret

# Callback receiver used by npm run example:submit
EXAMPLE_CALLBACK_PORT=58801

# Ports the provider tests may listen on (first free port is used)
EINVOICE_AE_TEST_PORTS=58801-58809

# Validation image used by npm run validate and npm run test:conformance
EINVOICE_AE_VALIDATOR_IMAGE=einvoice-ae-validator:local
